<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionLock</PackageId>
    <Description>Distributed locking for .NET. A backend-agnostic IDistributedLock with blocking acquire, reentrancy, and background lease auto-renewal. Backends ship separately (OrionLock.Redis, OrionLock.EntityFrameworkCore).</Description>
    <PackageTags>distributed-lock;redis;redlock;ef-core;locking;concurrency</PackageTags>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.24508.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionLock.Tests" />
    <InternalsVisibleTo Include="Moongazing.OrionLock.Testing.Tests" />
    <InternalsVisibleTo Include="Moongazing.OrionLock.HealthChecks" />
    <InternalsVisibleTo Include="Moongazing.OrionLock.HealthChecks.Tests" />
    <!--
      The SQL Server backend overrides WaitForAcquireAsync and so runs its own retry loop, which
      needs the same exponential-ceiling-with-jitter figure PollUntilAcquiredAsync uses. That lives
      in ComputeJitteredDelay, and reaching it here is what keeps ONE backoff implementation in the
      library - a second one in a backend package is how the shapes drift apart, which is the reason
      LockWaitPolicy.ToPollOptions is public in the first place.
    -->
    <InternalsVisibleTo Include="Moongazing.OrionLock.SqlServer" />
    <InternalsVisibleTo Include="Moongazing.OrionLock.SqlServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
